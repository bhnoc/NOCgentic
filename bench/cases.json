  "nl_sql": [
    {
      "id": "sql-01-top-talkers",
      "query": "Show me the top talkers by outbound bytes today",
      "iocs": [],
      "expected_tables": ["conn"],
      "notes": "Top talkers aggregate on conn.resp_bytes/orig_bytes."
    },
    {
      "id": "sql-02-dns-long",
      "query": "Find DNS queries for unusually long domains in the last 24 hours (possible tunneling)",
      "iocs": [],
      "expected_tables": ["dns"],
      "notes": "DNS anomaly hunt on the dns table."
    },
    {
      "id": "sql-03-ssl-sni",
      "query": "List SSL connections with unusual server names seen today",
      "iocs": [],
      "expected_tables": ["ssl"],
      "notes": "SSL SNI review on the ssl table."
    },
    {
      "id": "sql-04-ip-investigate",
      "query": "Investigate all connections involving 203.0.113.10",
      "iocs": ["203.0.113.10"],
      "expected_tables": ["conn", "alerts"],
      "notes": "IP investigation, primarily conn (id_orig_h / id_resp_h)."
    },
    {
      "id": "sql-05-http-host",
      "query": "Show HTTP requests to any host containing the word update",
      "iocs": [],
      "expected_tables": ["http"],
      "notes": "HTTP host filter on the http table."
    },
    {
      "id": "sql-06-bruteforce",
      "query": "Find brute force or credential-guessing attacks in the alerts",
      "iocs": [],
      "expected_tables": ["alerts"],
      "notes": "Brute-force hunt uses broad LIKE on alerts.alert_name."
    },
    {
      "id": "sql-07-files-hash",
      "query": "Show file transfers today along with their sha256 hashes",
      "iocs": [],
      "expected_tables": ["files"],
      "notes": "File-transfer review on the files table (has sha256)."
    },
    {
      "id": "sql-08-lateral",
      "query": "Detect lateral movement between different conference zones",
      "iocs": [],
      "expected_tables": ["suricata_corelight", "conn"],
      "notes": "Lateral movement uses suricata_corelight (both-side zones) or conn on sensitive ports."
    },
    {
      "id": "sql-09-uid-pivot",
      "query": "Look up everything related to session uid CXyz1234567890abcd",
      "iocs": ["CXyz1234567890abcd"],
      "expected_tables": ["uid_lookup"],
      "notes": "Session correlation via the fast uid_lookup index (orig_h / resp_h, no id_ prefix)."
    },
    {
      "id": "sql-10-zone-alerts",
      "query": "Show high severity alerts originating from the Registration zone",
      "iocs": [],
      "expected_tables": ["alerts"],
      "notes": "Zone-scoped alert query: alerts.orig_network_name, severity is a string enum."
    }
  ],

