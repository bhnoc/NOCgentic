# OpenRouter API Key for LLM access (required)
# Get yours at https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-key-here

# OpenSearch — public ingestion API endpoint
OPENSEARCH_API_URL=https://<your-ec2-ip>
OPENSEARCH_API_KEY=bhasia-cl-your-api-key-here

# OpenSearch — internal URL (set this when running agents on EC2 alongside OpenSearch)
# For Docker Compose deployments this is handled automatically via service name.
# Override locally if you have a local OpenSearch instance.
OPENSEARCH_INTERNAL_URL=http://localhost:9200

# Web server
PORT=3000
NODE_ENV=development

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Agent URLs (used by the web server and orchestrator in local/non-Docker dev)
# In Docker Compose these are set automatically via service names.
ORCHESTRATOR_URL=http://localhost:8001
THREAT_HUNTER_URL=http://localhost:8002
ALERT_TRIAGE_URL=http://localhost:8003
