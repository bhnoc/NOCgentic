# BHNOCgentic environment template. Copy to .env.s3 and fill in real values.
# NEVER commit the filled-in file. Placeholders below carry NO real secrets.
#
# AWS credentials are NOT set here. Containers get AWS access via the EC2
# instance role (IMDSv2), which delivers auto-rotating credentials. Do NOT add
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN. Setting them
# freezes creds at container start and breaks after the instance-role rotation.

# --- LLM ---------------------------------------------------------------------
# Provider selector. Live default is gemini; set to openrouter to use OpenRouter.
LLM_PROVIDER=gemini
# Gemini API key (required when LLM_PROVIDER=gemini).
GEMINI_API_KEY=your-gemini-key-here
# Gemini model id.
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenRouter API key (required when LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=your-openrouter-key-here

# --- Athena (structured Corelight/Zeek query path) ---------------------------
# Glue/Athena database holding the Parquet tables.
ATHENA_DATABASE=blackhat_pope_logs
# Athena workgroup used for query execution and result output.
ATHENA_WORKGROUP=blackhat-pope-dev
# AWS region for Athena.
ATHENA_REGION=us-west-2

# --- S3 (raw log source for the S3-scanning agents) --------------------------
# Bucket holding the raw logs.
S3_BUCKET=blackhat-pope-dev-logs
# Key prefix under the bucket.
S3_PREFIX=bh-asia-26/corelight
# AWS region for the bucket.
S3_REGION=us-west-2

# --- Audit monitor (trace viewer over S3 spans) ------------------------------
# Bucket holding the OTel span traces.
AUDIT_BUCKET=blackhat-pope-dev-logs
# Prefix under the bucket where traces land.
AUDIT_PREFIX=bh-asia-26/aing-trace
# AWS region for the trace bucket.
AUDIT_REGION=us-west-2
# Shared bearer secret gating the trace viewer (required; server 401s without it).
AUDIT_BEARER_TOKEN=your-audit-bearer-token-here
# HMAC key for signing session cookies (set a strong random value in prod).
AUDIT_COOKIE_SECRET=your-audit-cookie-secret-here
# Session cookie lifetime in seconds.
AUDIT_COOKIE_TTL=86400
# Poll interval (seconds) for new trace objects.
AUDIT_POLL_S=2
# Initial lookback window (seconds) on startup.
AUDIT_LOOKBACK=300

# --- Admin / integrations ----------------------------------------------------
# Bearer token protecting the orchestrator /admin/* routes (kill-switch, etc.).
ADMIN_BEARER_TOKEN=your-admin-bearer-token-here
# ThousandEyes API bearer token for the network-health agent.
THOUSANDEYES_BEARER_TOKEN=your-thousandeyes-bearer-token-here

# --- OpenTelemetry (traces/metrics to Manifold) ------------------------------
# Enable OTel export.
OTEL_ENABLED=true
# OTLP collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint-here
# API key sent with OTLP export requests.
OTEL_EXPORTER_OTLP_API_KEY=your-otel-api-key-here

# --- Alert cache tuning ------------------------------------------------------
# Web-server alert cache refresh interval (ms).
ALERT_REFRESH_MS=1800000
# How far back the alert feed looks (hours).
ALERT_LOOKBACK_HOURS=24
# Max alerts fetched per refresh.
ALERT_MAX_FETCH=200
