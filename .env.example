# BHNOCgentic environment template. Copy to .env.s3 and fill in real values.
# NEVER commit the filled-in file. Placeholders below carry NO real secrets.
#
# AWS credentials are NOT set here. Containers get AWS access via the EC2
# instance role (IMDSv2), which delivers auto-rotating credentials. Do NOT add
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN. Setting them
# freezes creds at container start and breaks after the instance-role rotation.

# --- Public branding ---------------------------------------------------------
# Event edition shown to attendees in the UI tagline and agent responses.
# Nation + year ONLY (the "Black Hat" wrapper is added in code). Next year is a
# one-line change, e.g. "USA 2027" or "Asia 2026". Display only — do NOT use for
# S3 prefixes / IAM names. These are opaque storage keys, not branding.
EVENT_EDITION=USA 2026

# --- Event timezone ----------------------------------------------------------
# The venue's wall clock. This one is NOT branding, it changes query results.
# Athena's dt partition is a UTC calendar day, so "today" has to be resolved
# against the analyst's local day. In Las Vegas (UTC-7) the UTC date rolls over at
# 17:00 local, and a UTC-only "today" then covers just the hours since 17:00. On
# prod at 19:33 local that was 778,187 alerts against a true 4,186,931.
# Any IANA zone name. Asia editions: Asia/Singapore. Europe: Europe/London.
EVENT_TZ=America/Los_Angeles

# --- LLM ---------------------------------------------------------------------
# Provider selector: gemini (cloud, default), openrouter (cloud), or local (on-box).
# Per box: a CPU/no-GPU host uses gemini; the GPU box can use local (llama.cpp/Ollama/vLLM).
LLM_PROVIDER=gemini
# Gemini API key (required when LLM_PROVIDER=gemini).
GEMINI_API_KEY=your-gemini-key-here
# Gemini model id.
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenRouter API key (required when LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=your-openrouter-key-here
# Local provider (required when LLM_PROVIDER=local): an OpenAI-compatible server on
# the GPU box. Base URL is where llama.cpp `llama-server` / Ollama / vLLM listens;
# the key is a placeholder local servers ignore. Set the served model name.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=not-needed

# --- Lane race (cloud vs local, side by side) ---------------------------------
# Two provider stacks answer the same query concurrently; the fastest is shown and
# the UI offers a swap to read the other.
#   cloud : Gemini for NL->SQL and prose
#   local : AQLight for both, unless you split the roles (LOCAL_PROSE_* below)
#
# auto (default) races only when a local endpoint below is set, so a CPU-only box
# runs single-lane with no failed calls. "on" forces it, "off" disables it.
LANE_RACE=auto
# AQLight's llama-server (NL->SQL). Falls back to LOCAL_LLM_BASE_URL when unset.
LOCAL_SQL_BASE_URL=http://localhost:8080/v1
LOCAL_SQL_MODEL=AQLight
# Prose model. Unset -> falls back to the SQL endpoint above, so AQLight writes the
# analyst-facing text too. That is the default because AQLight is the only local model
# already running as a durable service on the GPU box.
#
# Set these to split the roles across two ports, which you need because one
# llama-server process serves one GGUF. On measurement, Cisco
# Foundation-Sec-8B-*Instruct* is the better model at BOTH roles, so if you are
# standing up a second server, point LOCAL_SQL_* and LOCAL_PROSE_* at it rather than
# splitting the roles between AQLight and Foundation-Sec.
# LOCAL_PROSE_BASE_URL=http://localhost:8081/v1
# LOCAL_PROSE_MODEL=Foundation-Sec

# --- Lane mode (which lanes run at all) ---------------------------------------
# Overrides LANE_RACE outright when set to one of hybrid | cloud | local:
#   hybrid : both lanes race (the demo default on the GPU box)
#   cloud  : Gemini only. The mode for a CPU-only deployment.
#   local  : the box only. Nothing leaves it, and it does NOT fall back to the
#            cloud when the local endpoint is down: it fails loudly instead,
#            because a quiet fallback would defeat the reason for choosing this.
#
# Leave it EMPTY and the mode is derived from LANE_RACE, which keeps every existing
# box behaving exactly as before. Empty is not the same as LANE_MODE=cloud: derived
# cloud still uses the ambient LLM_PROVIDER, so an OpenRouter box stays on
# OpenRouter, while an explicit "cloud" pins the Gemini lane.
LANE_MODE=
# Show the losing lane and offer the swap. The race still runs when this is false;
# the loser is just cancelled and no lane metadata is reported. Turn it off for a
# single-answer demo. An operator can flip both of these at runtime from the
# settings gear in the audit monitor: that override is process state, so a restart
# comes back to whatever is set here. See docs/llm/lane-mode.md.
LANE_SIDE_BY_SIDE=true

# --- Model supervisor (start/stop local models from the gear) ------------------
# The settings gear can start and stop the llama-server units on the GPU host. That
# capability lives in a small process ON THE HOST (ops/model-supervisor/), not in a
# container, because every way of letting a container spawn host processes ends with
# the container that talks to an external LLM able to run root commands on the box.
#
# Leave both unset on any box without local models: the model panel then renders
# read-only, which is correct rather than broken. Discovery still works without it.
# The token is a shared secret with the host unit, not an AWS or LLM credential.
MODEL_SUPERVISOR_URL=
MODEL_SUPERVISOR_TOKEN=

# --- Response cache (Redis) ---------------------------------------------------
# Finished answers, keyed by question text and shared across callers. Ask something
# somebody already asked and it comes straight back instead of re-running
# classification, NL->SQL, Athena and the write-up. Nothing persists past a
# redeploy: the redis service has no volume, on purpose.
#
# The cache sits AFTER every guardrail in the orchestrator, so a hit can never be a
# guardrail cover or a quarantined session's answer. Do not move it in front of
# those checks: the key is the query text alone, so entries are shared between
# callers by design.
REDIS_URL=redis://redis:6379/0
RESPONSE_CACHE_ENABLED=true
# How long an answer stays good. Longer than the 300s Athena SQL cache because what
# is cached is more expensive to rebuild and less sensitive to being a few minutes
# stale. Shorten it for a show where freshness beats hit rate.
RESPONSE_CACHE_TTL_SECONDS=900
# Hits are padded to a random total wall-clock in this window. A cached answer that
# returned in 20ms next to a live one taking 8s would make response time a side
# channel, and a FIXED delay would be a tell of its own, so it is drawn uniformly.
# This is a target total, not an added delay: the padding subtracts time already
# spent, so a hit lands 2-5s after the request started.
RESPONSE_CACHE_HIT_DELAY_MIN=2.0
RESPONSE_CACHE_HIT_DELAY_MAX=5.0

# --- Athena (structured Corelight/Zeek query path) ---------------------------
# Glue/Athena database holding the Parquet tables.
ATHENA_DATABASE=blackhatnoc_glue
# Athena workgroup used for query execution and result output.
ATHENA_WORKGROUP=blackhatnoc-usa2026
# AWS region for Athena.
ATHENA_REGION=us-east-2

# --- S3 (raw log source for the S3-scanning agents) --------------------------
# Bucket holding the raw logs.
S3_BUCKET=blackhatnoc
# Key prefix under the bucket.
S3_PREFIX=nocgentic/corelight
# AWS region for the bucket.
S3_REGION=us-east-2

# --- Audit monitor (trace viewer over S3 spans) ------------------------------
# Bucket holding the OTel span traces.
AUDIT_BUCKET=blackhatnoc
# Prefix under the bucket where traces land.
AUDIT_PREFIX=nocgentic/traces
# AWS region for the trace bucket.
AUDIT_REGION=us-east-2
# Shared bearer secret gating the trace viewer (required; server 401s without it).
AUDIT_BEARER_TOKEN=your-audit-bearer-token-here
# HMAC key for signing session cookies (set a strong random value in prod).
AUDIT_COOKIE_SECRET=your-audit-cookie-secret-here
# Session cookie lifetime in seconds.
AUDIT_COOKIE_TTL=86400
# Poll interval (seconds) for new trace objects.
AUDIT_POLL_S=2
# Initial lookback window (seconds) on startup.
AUDIT_LOOKBACK=300

# --- Admin / integrations ----------------------------------------------------
# Bearer token protecting the orchestrator /admin/* routes (kill-switch,
# quarantine). The webhook receiver uses this to call /admin/quarantine.
ADMIN_BEARER_TOKEN=your-admin-bearer-token-here
# ThousandEyes API bearer token for the network-health agent.
THOUSANDEYES_BEARER_TOKEN=your-thousandeyes-bearer-token-here

# --- Manifold webhook receiver -----------------------------------------------
# Bearer token Manifold must present to POST /api/v1/manifold/webhook. Set this
# as the connector's Auth Token with Auth Type = bearer. Generate a dedicated
# one per environment: `openssl rand -hex 32`.
#
# Fails CLOSED: while this is unset the endpoint rejects everything with 401, so
# an unconfigured deploy cannot accept anonymous quarantine requests. That path
# is exempt from nginx's CloudFront origin lock (Manifold is SaaS and can send
# neither an allow-listed source IP nor ORIGIN_SECRET), so this token is the
# only thing guarding it. Treat it like a production credential.
MANIFOLD_WEBHOOK_TOKEN=your-manifold-webhook-token-here

# How long a session stays quarantined after a high/critical Manifold threat,
# in seconds. Expiry is automatic; an operator can also clear it early via
# DELETE /admin/quarantine/<session_id>. Default 1800 (30 min).
QUARANTINE_TTL_SECONDS=1800

# --- Deter agent (what a quarantined session gets instead of a refusal) -------
# A contained session's queries go to the deter agent, which answers them for
# real from a pool of data vetted as safe to hand to a hostile caller
# (agents/deter/safe_pool.py). The caller gets something useful and on-topic and
# no signal that they were detected. See docs/security/deter-agent.md.
#
# false reverts contained sessions to the canned cover paragraphs. Every failure
# path already does that silently, so this is a kill-switch, not a repair.
DETER_ENABLED=true
#
# Ceiling on the orchestrator's deter round-trip, in seconds. Deliberately far
# below the 180s the specialist agents get: a contained caller who waits three
# minutes learns more from the wait than from any answer. Past it, cover.
DETER_TIMEOUT_SECONDS=25.0
#
# Model for the deter answer, pinned separately from the platform-wide
# GEMINI_MODEL. Short prose over a small JSON context is the cheapest tier's
# ideal job and not the hunt agents' workload, so it should not inherit theirs.
# gemini-2.5-flash-lite measured best on 2026-08-04: p50 0.89s, p95 1.03s, 100%
# output-screen pass. Re-run scripts/bench_deter_models.py before changing.
DETER_MODEL=gemini-2.5-flash-lite
#
# Wall-clock FLOOR for the deter path, including its cover fallback. Anything
# faster is padded out to a target drawn fresh from this window (a constant total
# would be its own signature — real answers scatter, and nothing else on the
# platform lands at exactly 3.00s every time). Padding is one-sided: an answer
# already slower than the window goes straight out.
#
# [2, 6] is a deliberate trade-off, made with the measurement in hand. On the prod
# box, 2026-08-04:
#     athena-hunter         n=99  p50 17.02s  p95 33.94s  min 2.17s  max 44.80s
#     alert-triage          n=37  p50 32.78s  p95 53.08s
#     thousandeyes-analyst  n=59  p50 10.84s  p95 18.76s
# The deter agent's own p95 is ~1s, so the padding sets the response time outright.
#
# A deter response reports agent_used=athena-hunter, so this is faster than the
# agent it impersonates and a caller timing many turns against a known-good
# athena-hunter answer could notice. What it buys: 2-6s is plausible tool latency
# in absolute terms (2.17s is inside athena-hunter's real range), it closes the
# millisecond gap that was visible in a single turn with no baseline, the 4s
# spread scatters more than a 2s one, and it keeps the platform responsive for the
# false positives containment will produce.
#
# Widen toward the table above if timing indistinguishability starts to matter
# more than responsiveness. Re-measure on your own box first; the command is in
# docs/security/deter-agent.md.
DETER_PACE_MIN_SECONDS=2.0
DETER_PACE_MAX_SECONDS=6.0
#
# false (the default) serves each facet's static roll-up, which is a complete
# answer on its own and needs no AWS access. true reads live venue aggregates
# instead, with the static roll-up as the per-facet fallback. Either way the
# caller's text NEVER reaches SQL — it selects which author-written aggregate is
# read and nothing more.
DETER_ATHENA_ENABLED=false
DETER_WINDOW_HOURS=24
# Per-facet Athena ceiling. Past it that facet quietly serves static: a contained
# session must not be able to tell that a backend was slow.
DETER_ATHENA_TIMEOUT=12.0

# --- Public hostnames / edge access ------------------------------------------
# Origins allowed to open the /ws WebSocket, comma-separated. The browser derives
# the socket URL from location.host, so EVERY hostname the app is served on must
# be listed here or that host's UI sits on RECONNECT while HTTP still works.
# A foreign origin is still rejected; this is not a wildcard.
ALLOWED_ORIGIN=https://ng.bhnoc.com,https://ngremote.bhnoc.com
#
# Shared secret proving a request came through OUR CloudFront distribution
# (sent by it as the X-Origin-Secret header). ops/deploy.sh injects this into
# nginx/nginx-ssl.conf, rendered from nginx-ssl.conf.template.
#
# REQUIRED whenever the security group allows the CloudFront origin-facing
# prefix list to :443. That range is shared by every AWS customer, so without
# this secret any other customer's distribution can reach this origin. The
# deploy refuses to run if it's unset. Rotate by updating both this value and
# the distribution's custom origin header.
ORIGIN_SECRET=your-cloudfront-origin-secret-here

# --- OpenTelemetry (traces/metrics to Manifold) ------------------------------
# Enable OTel export.
OTEL_ENABLED=true
# OTLP collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint-here
# API key sent with OTLP export requests.
OTEL_EXPORTER_OTLP_API_KEY=your-otel-api-key-here

# --- Alert cache tuning ------------------------------------------------------
# Web-server alert cache refresh interval (ms).
ALERT_REFRESH_MS=1800000
# How far back the alert feed looks (hours).
ALERT_LOOKBACK_HOURS=24
# Max alerts fetched per refresh.
ALERT_MAX_FETCH=200
