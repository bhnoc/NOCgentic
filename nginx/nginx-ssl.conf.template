worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Security headers
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Docker's embedded DNS. Required for dynamic upstream re-resolution so
    # that recreating a container (new IP on the Docker bridge) doesn't leave
    # nginx holding the old address forever.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # NOTE: We intentionally do NOT use `upstream { server X; }` blocks.
    # Nginx resolves those once at startup and caches the IP forever.
    # Instead, each `location` sets a variable and uses it in proxy_pass,
    # which forces re-resolution via the docker DNS on every request
    # (cached for `valid=10s`).

    # ---- Origin protection for the CloudFront alias (ngremote.bhnoc.com) ----
    # Clients on the Black Hat / operator allow-list reach us directly and are
    # trusted by source IP. Everyone else arrives via CloudFront, whose whole
    # origin-facing IP range is allowed to :443 by a security group — and that
    # range is SHARED BY EVERY AWS CUSTOMER. So a request from it must also
    # present the shared secret to prove it came through OUR distribution.
    # Without this check, anyone's distribution can reach this origin.
    geo $direct_trusted {
        default 0;
        69.8.253.0/24     1;  # Black Hat USA
        66.205.200.64/29  1;  # L34n
        136.36.99.230/32  1;  # John Gillis
        136.59.5.6/32     1;  # James
        208.93.179.62/32  1;  # Spicer
        136.38.201.241/32 1;  # Spicer2
        204.228.156.49/32 1;  # klipper
        69.8.253.15/32    1;
        10.20.0.0/16      1;  # VPC
        127.0.0.1/32      1;
        # Docker's userland port-proxy SNATs host-local traffic (the deploy's
        # https://127.0.0.1/health check, certbot) to the bridge GATEWAY, so
        # nginx sees 172.18.0.1 — not 127.0.0.1. Without this the post-deploy
        # health check 403s and every deploy fails. Gateways only, not the whole
        # /16: containers themselves must still present the secret.
        172.18.0.1/32     1;  # app_default gateway (compose)
        172.17.0.1/32     1;  # default bridge gateway
    }

    map "$direct_trusted:$http_x_origin_secret" $origin_denied {
        default                    1;
        "~^1:"                     0;  # trusted source IP — no header needed
        "0:__ORIGIN_SECRET__"      0;  # untrusted source — must present the secret
    }

    # ---- Origin-lock exemption: the Manifold webhook receiver ----
    # Manifold's control plane is SaaS. It is neither an allow-listed source IP
    # nor able to present ORIGIN_SECRET, so the lock above would 403 it. For
    # Manifold a 403 is PERMANENT — its retry table retries only 408/429/5xx, so
    # every threat would be dropped silently and the receiver would look healthy
    # while receiving nothing. Exempt the path; it enforces its own bearer token
    # (MANIFOLD_WEBHOOK_TOKEN, constant-time compared, fails closed when unset).
    map $uri $origin_lock_exempt {
        default                          0;
        "~^/api/v1/manifold/webhook/?$"  1;
    }

    map "$origin_denied:$origin_lock_exempt" $edge_denied {
        default   1;
        "0:0"     0;  # passed the origin lock normally
        "0:1"     0;  # passed, and on an exempt path
        "1:1"     0;  # failed the lock, but the path is exempt (bearer-authed)
    }

    # Redirect HTTP -> HTTPS
    server {
        listen 80;
        server_name _;

        # Allow ACME challenge for cert renewal
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS server
    server {
        listen 443 ssl;
        server_name _;

        # Enforced on 443 only — port 80 must stay open for the ACME challenge.
        # $edge_denied is $origin_denied with the webhook-path exemption folded in.
        if ($edge_denied) { return 403; }

        ssl_certificate     /etc/letsencrypt/live/current/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/current/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Chat API
        location /api/v1/chat {
            set $web_upstream "web-server";
            proxy_pass http://$web_upstream:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Alerts API
        location /api/v1/alerts {
            set $web_upstream "web-server";
            proxy_pass http://$web_upstream:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # WebSocket
        location /ws {
            set $web_upstream "web-server";
            proxy_pass http://$web_upstream:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 3600s;
        }

        # Health
        location /health {
            allow all;
            set $web_upstream "web-server";
            proxy_pass http://$web_upstream:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # Audit monitor — token-gated, SSE-heavy, proxy without buffering.
        # The rewrite strips the /bh/1337/thetraces/ prefix so the FastAPI
        # app (which also sets root_path for URL generation) sees clean paths.
        location /bh/1337/thetraces/ {
            # OPERATOR-ONLY edge allow-list. This box is the TLS terminator, so
            # $remote_addr is the true client IP and `allow`/`deny` match it
            # directly (X-Forwarded-For is irrelevant here — nothing in front of
            # us). Layer A of two: pairs with the AWS security-group allow-list;
            # the app's session cookie (layer B) is the inner gate.
            allow 136.59.5.6;     # James
            allow 208.93.179.62;  # Spicer
            allow 136.38.201.241; # Spicer2
            allow 69.8.253.0/24;  # Black Hat USA conf network, widened for floor demo 2026-08-05
            deny all;

            set $audit_upstream "audit-monitor";
            rewrite ^/bh/1337/thetraces/(.*)$ /$1 break;
            proxy_pass http://$audit_upstream:8787;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Prefix /bh/1337/thetraces;

            # SSE / long-lived streams
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            # Pass through WebSocket headers (harmless for plain HTTP)
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Zeek AI-detection pipeline — analyst access (APE-786).
        # Two-layer gate: Layer A (nginx) IP allowlist + Layer B (service) bearer token.
        # Nginx injects the stored token so analysts authenticate by source IP only.
        # Enable the zeek compose profile (COMPOSE_PROFILES=zeek) and set
        # ZEEK_DETECTOR_API_TOKEN in .env.s3 before first use.
        location /zeek/ {
            allow 136.59.5.6;     # James
            allow 208.93.179.62;  # Spicer
            allow 136.38.201.241; # Spicer2
            allow 69.8.253.0/24;  # Black Hat USA
            allow 10.20.0.0/16;   # VPC
            deny all;

            set $zeek_upstream "zeek-detector";
            rewrite ^/zeek/(.*)$ /$1 break;
            proxy_pass http://$zeek_upstream:8007;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Prefix /zeek;
            proxy_set_header Authorization "Bearer __ZEEK_DETECTOR_API_TOKEN__";

            # Log uploads can be large; the service enforces ZEEK_MAX_UPLOAD_BYTES
            # (default 50 MB) as a hard cap, so this just needs to stay above it.
            client_max_body_size 60m;
        }

        # Default: serve web UI
        location / {
            set $web_upstream "web-server";
            proxy_pass http://$web_upstream:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
